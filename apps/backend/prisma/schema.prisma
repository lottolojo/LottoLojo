// Prisma schema voor Lotto LoJo
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   // 'admin' of 'participant'
  approved  Boolean  @default(false)
  blocked   Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   ParticipantProfile?
  selections NumberSelection[]
  entries   DrawEntry[]
  payouts   Payout[]
  twoFactorCodes TwoFactorCode[]
}

model ParticipantProfile {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  creditsBalance Float @default(0)
  active    Boolean @default(true)
  unsubscribeAfterCurrentDraw Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NumberSelection {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  numbers   Json
  validFromDrawId Int
  lockedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Draw {
  id        Int      @id @default(autoincrement())
  drawDate  DateTime
  winningNumbers Json
  reserveNumber Int?
  published Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  entries   DrawEntry[]
  potTransactions PotTransaction[]
  payouts   Payout[]
}

model DrawEntry {
  id        Int      @id @default(autoincrement())
  draw      Draw     @relation(fields: [drawId], references: [id])
  drawId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  selectedNumbers Json
  paid      Boolean
  entryFee  Float
  participated Boolean
  excludedReason String?
  matches   Json
  matchCount Int
  isWinner  Boolean @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id        Int      @id @default(autoincrement())
  entryFee  Float    @default(3)
  organizerPercentage Float @default(0.25)
  numberChangeDeadlineTime String @default("13:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PotTransaction {
  id        Int      @id @default(autoincrement())
  draw      Draw     @relation(fields: [drawId], references: [id])
  drawId    Int
  type      String
  amount    Float
  description String?
  createdAt DateTime @default(now())
}

model Payout {
  id        Int      @id @default(autoincrement())
  draw      Draw     @relation(fields: [drawId], references: [id])
  drawId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  grossPot  Float
  organizerFee Float
  payoutAmount Float
  paidOut   Boolean @default(false)
  createdAt DateTime @default(now())
}

model TwoFactorCode {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
